<?xml version="1.0" encoding="UTF-8"?>
<!--
  SPDX-License-Identifier: Apache-2.0
  macOS: launchd agent. Replace REPLACE_WITH_PATH with the folder you cloned into.
  1. cp scripts/io.github.herdr-app-zh.plist ~/Library/LaunchAgents/
  2. launchctl load -w ~/Library/LaunchAgents/io.github.herdr-app-zh.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.herdr-app-zh</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>REPLACE_WITH_PATH/src/zh_watch.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/herdr-app-zh.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/herdr-app-zh.log</string>
</dict>
</plist>
